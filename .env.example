# Cadena de conexión de Neon (Postgres). Cópiala desde el dashboard de Neon
# (Connection string, modo "Pooled connection" recomendado para serverless).
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Puerto para desarrollo local (opcional, por defecto 3000).
PORT=3000

# Llave compartida para los endpoints de solo lectura /api/integrations/*
# (header x-integration-key). Sin esta variable, esos endpoints quedan
# deshabilitados (503) en vez de abiertos por accidente. No afecta a los
# endpoints públicos existentes (/api/labels, /api/nc-reports).
FFT_INTEGRATIONS_KEY=
