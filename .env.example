# Cadena de conexión de Neon (Postgres). Cópiala desde el dashboard de Neon
# (Connection string, modo "Pooled connection" recomendado para serverless).
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Puerto para desarrollo local (opcional, por defecto 3000).
PORT=3000
